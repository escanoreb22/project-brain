{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Brain State",
  "type": "object",
  "required": ["schema_version", "project", "phase", "phase_approval", "active_role", "active_task", "updated_at"],
  "properties": {
    "schema_version": {"const": 1},
    "project": {"type": "string", "minLength": 1},
    "phase": {"enum": ["idea", "requirements", "architecture", "design", "planned", "implementing", "verifying", "release_ready", "released", "maintenance"]},
    "phase_approval": {"enum": ["pending", "approved", "not_required"]},
    "active_role": {"enum": ["idea", "planner", "tracker", "designer", "security", "coder", "none"]},
    "active_task": {"type": ["string", "null"]},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": true
}
